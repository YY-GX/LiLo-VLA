---
import { Icon } from "astro-icon/components";

type Author = {
  name: string;
  url?: string;
  institution?: string;
  notes?: string[];
};

type Note = {
  symbol: string;
  text: string;
};

type Link = {
  url: string;
  name: string;
  icon?: string;
};

interface Props {
  title: string;
  subtitle?: string;
  authors: Author[];
  conference?: string;
  notes?: Note[];
  links?: Link[];
}

const { title, subtitle, authors, conference, notes, links } = Astro.props;

// Same rule as PageNav: a relative link is resolved against the base path, an
// absolute one is left alone. Keeps `static/pdfs/main.pdf` working wherever the
// page is served from.
const base = import.meta.env.BASE_URL;
const prefix = base.endsWith("/") ? base : base + "/";
const href = (url: string) =>
  /^(https?:|mailto:|#)/.test(url) ? url : prefix + url;

const hasBackground = Astro.slots.has("background");
---

<header
  class:list={[
    "full-bleed relative mb-12",
    hasBackground && "-mt-16 pt-24 pb-28",
  ]}
>
  {
    hasBackground && (
      <div class="cover absolute inset-0 z-0 overflow-hidden">
        <slot name="background" />
        {/* Darken the cover so the white header text stays legible. */}
        <div class="absolute inset-0 bg-black/40" />
      </div>
    )
  }
  <div
    class:list={[
      "relative z-10 mx-auto flex max-w-[50rem] flex-col items-center px-6 text-center",
      hasBackground
        ? "gap-10 text-white prose-headings:text-white [text-shadow:0_0_8px_rgba(0,0,0,0.6)]"
        : "gap-5",
    ]}
  >
    <h1 class="my-0 text-4xl leading-tight font-medium tracking-tight text-balance sm:text-5xl">
      {title}
    </h1>
    {
      subtitle && (
        <p class="text-muted-foreground -mt-1 mb-1 max-w-[38rem] text-xl text-balance">
          {subtitle}
        </p>
      )
    }
    <div class="flex flex-row flex-wrap justify-center gap-x-8 gap-y-4">
      {
        authors.map((author) => (
          <div class="flex flex-col items-center text-center">
            <div class="flex flex-row text-xl">
              {author.url ? (
                <a class:list={[hasBackground
                  ? "not-prose text-white/90 hover:text-white underline decoration-dashed underline-offset-4 hover:decoration-solid"
                  : "not-prose text-foreground decoration-border hover:text-primary hover:decoration-primary underline decoration-1 underline-offset-4 transition-colors"]} href={author.url}>{author.name}</a>
              ) : (
                author.name
              )}
              {author.notes && (
                <sup class="text-xl">
                  {author.notes.map(
                    (note, index, array) =>
                      note + (index < array.length - 1 ? "," : ""),
                  )}
                </sup>
              )}
            </div>
            {author.institution && (
              <div class="text-muted-foreground text-base">{author.institution}</div>
            )}
          </div>
        ))
      }
    </div>
    {conference && <div class="text-muted-foreground">{conference}</div>}
    {
      notes && (
        <div class="text-center text-sm">
          {
            // prettier-ignore
            notes.map((note, index, array) => (
              <span>
                <sup>{note.symbol}</sup>{note.text}{index < array.length - 1 ? "," : ""}
              </span>
            ))
          }
        </div>
      )
    }
    {
      links && (
        <div class="not-prose mt-3 flex flex-row flex-wrap justify-center gap-2">
          {links.map((link) => (
            <a
              href={href(link.url)}
              class:list={["flex flex-row items-center gap-2 rounded-full px-5 py-2 text-lg hover:no-underline",
                hasBackground ? "bg-background text-foreground hover:bg-muted text-shadow-none shadow-[0_0_8px_rgba(0,0,0,0.6)]" : "bg-foreground text-background hover:bg-primary transition-colors"
              ]}
            >
              {link.icon && <Icon name={link.icon} />}
              <span>{link.name}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</header>

<style>
  /* Make the slotted cover (Picture/Video, or a plain <img>/<video>) fill the
     header, overriding those components' figure styling. Scoped to `.cover`.
     Kept as scoped CSS because expressing it with Tailwind would require
     repeating the descendant variant on every declaration. */
  .cover :global(:is(picture, img, video)) {
    position: absolute;
    inset: 0;
    /* Zero the margin that `prose` adds to media elements, which would
       otherwise push the cover down and expose the page background. */
    margin: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    border-radius: 0;
  }
</style>
