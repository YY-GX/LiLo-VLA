(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language place black bowl on top of the cabinet)
    (:regions
      (wooden_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
          (-0.0000000001 -0.30 0.0 -0.29999999999)
          )
          )
          (:yaw_rotation (
          (3.141592653589793 3.141592653589793)
          )
          )
      )
      (akita_black_bowl_middle_init_region
          (:target kitchen_table)
          (:ranges (
          (-0.07500000000000001 0.17500000000000002 -0.025 0.225)
          )
          )
          (:yaw_rotation (
          (0.0 0.0)
          )
          )
          )
      (top_side
          (:target wooden_cabinet_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_1 - wooden_cabinet
  )

  (:objects
    akita_black_bowl_2 - akita_black_bowl
  )

  (:obj_of_interest
    akita_black_bowl_2
  )

  (:init
    (On akita_black_bowl_2 kitchen_table_akita_black_bowl_middle_init_region)
    (On wooden_cabinet_1 kitchen_table_wooden_cabinet_init_region)
  )

  (:goal
    (And (On akita_black_bowl_2 wooden_cabinet_1_top_side))
  )

)
