(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick moka pot, place moka pot on the stove 2, turn on the stove 2, pick frying pan, place frying pan on the stove 1, turn on the stove 1, open the microwave)
    (:regions
      (flat_stove_1_init_region
          (:target kitchen_table)
          (:ranges (                            
              (-0.02 -0.00 -0.01999 0.0001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (flat_stove_2_init_region
          (:target kitchen_table)
          (:ranges (                            
              (-0.02 0.3 -0.01999 0.31)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_2_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.25 0.3 -0.24 0.31)                            
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.25 0.05 -0.24 0.06)                            
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.3 -0.2 -0.2999 -0.19)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_2_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.3 -0.35 -0.2999 -0.34)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1 -0.25 -0.09 -0.24)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_2_init_region
          (:target kitchen_table)
          (:ranges (
              (0.05 -0.25 0.06 -0.24)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_2)
      )
      (cook_region
          (:target flat_stove_1)
      )
      (heat_region
          (:target microwave_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 flat_stove_2 - flat_stove
  )

  (:objects
    moka_pot_1 moka_pot_2 - moka_pot
    akita_black_bowl_1 akita_black_bowl_2 - akita_black_bowl
    plate_1 plate_2 - plate
  )

  (:obj_of_interest
    moka_pot_1
    moka_pot_2
    flat_stove_1
    flat_stove_2
  )

  (:init
    (On moka_pot_1 kitchen_table_moka_pot_init_region)
    (On moka_pot_2 kitchen_table_moka_pot_2_init_region)
    (On flat_stove_1 kitchen_table_flat_stove_1_init_region)
    (On flat_stove_2 kitchen_table_flat_stove_2_init_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_init_region)
    (On akita_black_bowl_2 kitchen_table_akita_black_bowl_2_init_region)
    (On plate_1 kitchen_table_plate_1_init_region)
    (On plate_2 kitchen_table_plate_2_init_region)
  )

  (:goal
    (And
      (On akita_black_bowl_1 plate_1)
      (On akita_black_bowl_2 plate_2)
      (On moka_pot_1 flat_stove_1_cook_region)
      (On moka_pot_2 flat_stove_2_cook_region)
      (Turnon flat_stove_2)
      (Turnon flat_stove_1)
    )
  )

)